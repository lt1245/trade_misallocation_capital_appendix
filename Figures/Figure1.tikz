% Plot 1: Foreign Credit to Firms (Quarterly)
\addplot [blue, thick, restrict x to domain=1990:2018]
    table [x=description, y=A] {\datatableentry};
\addlegendentry{Foreign Credit}

% Plot 2: Import Share
\addplot [red!70!black, thick, mark=*, mark options={scale=1, fill=white}] 
    table [x=description, y=B] {\datatariff};
\addlegendentry{Import Share}

% Plot 3: Avg. Tariff Rate on EU Imports (scaled to left axis)
\addplot [green!50!black, thick, dashed, mark=square*, mark options={scale=1}] 
    table [x=description, y expr=\thisrow{C}*90/12] {\dataeu};
\addlegendentry{Import Tariff}

\end{axis}

